<?xml version="1.0" encoding="utf-8"?>
<!--
  Origem única de pacotes para este repositório (Central Package Management exige origem
  única: NU1507). <clear/> descarta origens herdadas da configuração do usuário/máquina, de
  modo que restore e CI resolvam os mesmos pacotes em qualquer ambiente (Constituição VIII).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>

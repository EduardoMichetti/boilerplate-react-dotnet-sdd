# ==============================================================================
# Exemplo de variáveis de UMA instalação (infra/.env.example) — sem segredos.
#
# USO:
#   Instalação A: copie para infra/.env.local     (projeto Compose boilerplate-a)
#   Instalação B: copie para infra/.env.b.local   (projeto Compose boilerplate-b)
#   e defina os valores privados marcados com "definir valor privado".
#
# Este arquivo sozinho NÃO sobe nada: as variáveis obrigatórias vazias fazem o
# Compose falhar (${VAR:?}). Nunca versione arquivos .env*.local.
#
# Cada serviço recebe somente a própria credencial:
#   postgres   -> SENHA_SUPERUSUARIO_POSTGRES + variáveis do init-db.sh
#   api        -> <BANCO_APP>_runtime / SENHA_RUNTIME (sem DDL)
#   migrations -> <BANCO_APP>_owner / SENHA_OWNER
#   operations -> LOGIN_OPERADOR_ACESSO / SENHA_OPERADOR_ACESSO (login individual)
#
# RECRIAR O BANCO LOCAL DO ZERO: o init-db.sh só roda na criação do volume.
#   docker compose --project-name boilerplate-a -f infra/compose.yaml --env-file infra/.env.local down --volumes
#   (apaga dados e key ring locais da instalação A; nunca faça isso com dados de cliente)
# ==============================================================================

# --- Identidade da aplicação e da instalação (não secretos) -------------------
CodigoAplicacao=boilerplate-react-dotnet-sdd
IdAmbiente=11111111-1111-4111-8111-111111111111
IdTenant=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa
NomeExibicaoTenant=Cliente A (Exemplo Local)
# Inativo durante migrations; Ativo para a API atender.
EstadoTenant=Ativo

# Porta da API no loopback do host (A e B precisam de portas distintas).
PORTA_API=8080

# Banco exclusivo da instalação; as roles derivam deste nome:
#   <BANCO_APP>_owner, <BANCO_APP>_runtime, <BANCO_APP>_operador (grupo NOLOGIN)
BANCO_APP=appdb_cliente_a

# --- Segredos: definir valor privado (somente letras e dígitos) ---------------
# Superusuário do container PostgreSQL (somente o serviço postgres o recebe).
SENHA_SUPERUSUARIO_POSTGRES=
# Owner do banco (somente migrations).
SENHA_OWNER=
# Runtime da API (sem DDL, sem DELETE de sessões).
SENHA_RUNTIME=
# Login PostgreSQL INDIVIDUAL do operador de acesso (membro de <BANCO_APP>_operador),
# por exemplo appdb_cliente_a_op_<nome>. Não compartilhar entre pessoas.
LOGIN_OPERADOR_ACESSO=
SENHA_OPERADOR_ACESSO=

# --- Opcionais (vazio = ausente = padrão) -------------------------------------
# Prazo absoluto da sessão em minutos, inteiro 5–480 (padrão 30).
Sessao__PrazoAbsolutoMinutos=
# Retenção de sessões encerradas para `sessao limpar`, inteiro 1–365 (padrão 30).
OperacaoAcesso__RetencaoSessoesDias=
# Somente tooling: true apenas na primeira inicialização de banco vazio aprovado.
Migracoes__PermitirInicializarBancoVazio=false
# Somente com infra/compose.depuracao.yaml (PostgreSQL no loopback).
# PORTA_POSTGRES_DEPURACAO=5432

# ==============================================================================
# REFERÊNCIA PARA A INSTALAÇÃO B (infra/.env.b.local) — valores distintos de A:
# ------------------------------------------------------------------------------
# IdAmbiente=22222222-2222-4222-8222-222222222222
# IdTenant=bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb
# NomeExibicaoTenant=Cliente B (Exemplo Isolamento)
# PORTA_API=8081
# BANCO_APP=appdb_cliente_b
# (segredos próprios de B, nunca reaproveitados de A)
# PORTA_POSTGRES_DEPURACAO=5433
# ==============================================================================

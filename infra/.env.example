# ==============================================================================
# Arquivo de Exemplo de Variáveis de Ambiente da Instalação (infra/.env.example)
#
# INSTRUÇÕES DE USO:
# Para configurar uma instalação local (ex.: Cliente A), copie este arquivo para:
#   cp infra/.env.example infra/.env.local
# Para configurar uma segunda instalação para validação de isolamento (Cliente B):
#   cp infra/.env.example infra/.env.b.local
#
# IMPORTANTE:
# - Nunca versione arquivos .env*.local contendo segredos ou senhas reais.
# - A API monta apenas a credencial runtime (StringsConexao__BancoApp).
# - O tooling de migrations monta a credencial owner (StringsConexao__BancoAppProprietario).
# - Defina EstadoTenant=Inativo durante a aplicação de DDL/migrations.
# - Defina Migracoes__PermitirInicializarBancoVazio=true apenas na primeira inicialização
#   de um banco vazio aprovado, retornando para false imediatamente após o uso.
# ==============================================================================

# Identidade da Aplicação e do Ambiente
IdAplicacao=boilerplate-react-dotnet-sdd
IdAmbiente=11111111-1111-4111-8111-111111111111

# Identidade e Estado do Tenant da Instalação
IdTenant=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa
NomeExibicaoTenant=Cliente A (Exemplo Local)
# EstadoTenant: Inativo durante DDL/migrations; Ativo para inicialização da API
EstadoTenant=Ativo

# Porta exposta para a API desta instalação no host (ex.: 8080 para A, 8081 para B)
PORTA_API=8080

# Configuração do Container PostgreSQL (isolado por projeto do Compose)
POSTGRES_DB=appdb_cliente_a
POSTGRES_USER=owner_cliente_a
POSTGRES_PASSWORD=ExemploSenhaOwnerFicticia123!

# Conexão Runtime (utilizada exclusivamente pela App.Api - usuário sem privilégios de DDL)
StringsConexao__BancoApp=Host=postgres;Port=5432;Database=appdb_cliente_a;Username=owner_cliente_a;******

# Conexão Tooling / Owner (utilizada exclusivamente pelo serviço migrations para DDL)
StringsConexao__BancoAppProprietario=Host=postgres;Port=5432;Database=appdb_cliente_a;Username=owner_cliente_a;******

# Controle de Inicialização Técnica de Banco Vazio (somente tooling)
# Mantenha false por padrão; altere para true apenas na inicialização inicial do banco vazio
Migracoes__PermitirInicializarBancoVazio=false

# ==============================================================================
# CONFIGURAÇÃO DE REFERÊNCIA PARA CLIENTE B (infra/.env.b.local):
# ------------------------------------------------------------------------------
# IdAmbiente=22222222-2222-4222-8222-222222222222
# IdTenant=bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb
# NomeExibicaoTenant=Cliente B (Exemplo Isolamento)
# PORTA_API=8081
# POSTGRES_DB=appdb_cliente_b
# POSTGRES_USER=owner_cliente_b
# POSTGRES_PASSWORD=ExemploSenhaOwnerFicticiaB123!
# StringsConexao__BancoApp=Host=postgres;Port=5432;Database=appdb_cliente_b;Username=owner_cliente_b;******
# StringsConexao__BancoAppProprietario=Host=postgres;Port=5432;Database=appdb_cliente_b;Username=owner_cliente_b;******
# Migracoes__PermitirInicializarBancoVazio=false
# ==============================================================================

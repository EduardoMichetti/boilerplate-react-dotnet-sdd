# ==============================================================================
# Arquivo de Exemplo de Variáveis de Ambiente da Instalação (infra/.env.example)
#
# INSTRUÇÕES DE USO:
# Para configurar uma instalação local (ex.: Cliente A), copie este arquivo para:
#   cp infra/.env.example infra/.env.local
# Para configurar uma segunda instalação para validação de isolamento (Cliente B):
#   cp infra/.env.example infra/.env.b.local
#
# IMPORTANTE:
# - Nunca versione arquivos .env*.local contendo segredos ou senhas reais.
# - A API monta apenas a credencial runtime (ConnectionStrings__AppDb).
# - O tooling de migrations monta a credencial owner (ConnectionStrings__AppDbOwner).
# - Defina TenantState=Inactive durante a aplicação de DDL/migrations.
# - Defina Migrations__AllowInitializeEmptyDatabase=true apenas na primeira inicialização
#   de um banco vazio aprovado, retornando para false imediatamente após o uso.
# ==============================================================================

# Identidade da Aplicação e do Ambiente
ApplicationId=boilerplate-react-dotnet-sdd
EnvironmentId=11111111-1111-4111-8111-111111111111

# Identidade e Estado do Inquilino da Instalação
TenantId=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa
TenantDisplayName=Cliente A (Exemplo Local)
# TenantState: Inactive durante DDL/migrations; Active para inicialização da API
TenantState=Active

# Porta exposta para a API desta instalação no host (ex.: 8080 para A, 8081 para B)
API_PORT=8080

# Configuração do Container PostgreSQL (isolado por projeto do Compose)
POSTGRES_DB=appdb_cliente_a
POSTGRES_USER=owner_cliente_a
POSTGRES_PASSWORD=ExemploSenhaOwnerFicticia123!

# Conexão Runtime (utilizada exclusivamente pela App.Api - usuário sem privilégios de DDL)
ConnectionStrings__AppDb=Host=postgres;Port=5432;Database=appdb_cliente_a;Username=owner_cliente_a;Password=ExemploSenhaOwnerFicticia123!

# Conexão Tooling / Owner (utilizada exclusivamente pelo serviço migrations para DDL)
ConnectionStrings__AppDbOwner=Host=postgres;Port=5432;Database=appdb_cliente_a;Username=owner_cliente_a;Password=ExemploSenhaOwnerFicticia123!

# Controle de Inicialização Técnica de Banco Vazio (somente tooling)
# Mantenha false por padrão; altere para true apenas na inicialização inicial do banco vazio
Migrations__AllowInitializeEmptyDatabase=false

# ==============================================================================
# CONFIGURAÇÃO DE REFERÊNCIA PARA CLIENTE B (infra/.env.b.local):
# ------------------------------------------------------------------------------
# EnvironmentId=22222222-2222-4222-8222-222222222222
# TenantId=bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb
# TenantDisplayName=Cliente B (Exemplo Isolamento)
# API_PORT=8081
# POSTGRES_DB=appdb_cliente_b
# POSTGRES_USER=owner_cliente_b
# POSTGRES_PASSWORD=ExemploSenhaOwnerFicticiaB123!
# ConnectionStrings__AppDb=Host=postgres;Port=5432;Database=appdb_cliente_b;Username=owner_cliente_b;Password=ExemploSenhaOwnerFicticiaB123!
# ConnectionStrings__AppDbOwner=Host=postgres;Port=5432;Database=appdb_cliente_b;Username=owner_cliente_b;Password=ExemploSenhaOwnerFicticiaB123!
# Migrations__AllowInitializeEmptyDatabase=false
# ==============================================================================

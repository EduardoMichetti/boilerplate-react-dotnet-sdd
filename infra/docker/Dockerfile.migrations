FROM mcr.microsoft.com/dotnet/sdk:10.0.401

# Instalar a ferramenta dotnet-ef na versão exata 10.0.12 para operações pontuais de migração
RUN dotnet tool install --global dotnet-ef --version 10.0.12
ENV PATH="$PATH:/root/.dotnet/tools"

WORKDIR /src

# Copiar arquivos de configuração de compilação e versionamento central de pacotes
COPY ["Directory.Build.props", "./"]
COPY ["Directory.Packages.props", "./"]
COPY ["global.json", "./"]

# Copiar projetos e lockfiles para restore
COPY ["backend/src/Platform.Domain/Platform.Domain.csproj", "backend/src/Platform.Domain/"]
COPY ["backend/src/Platform.Domain/packages.lock.json", "backend/src/Platform.Domain/"]
COPY ["backend/src/Platform.Application/Platform.Application.csproj", "backend/src/Platform.Application/"]
COPY ["backend/src/Platform.Application/packages.lock.json", "backend/src/Platform.Application/"]
COPY ["backend/src/Platform.Infrastructure/Platform.Infrastructure.csproj", "backend/src/Platform.Infrastructure/"]
COPY ["backend/src/Platform.Infrastructure/packages.lock.json", "backend/src/Platform.Infrastructure/"]
COPY ["backend/src/App.Api/App.Api.csproj", "backend/src/App.Api/"]
COPY ["backend/src/App.Api/packages.lock.json", "backend/src/App.Api/"]

# Restaurar dependências utilizando locked-mode
RUN dotnet restore "backend/src/Platform.Infrastructure/Platform.Infrastructure.csproj" --locked-mode
RUN dotnet restore "backend/src/App.Api/App.Api.csproj" --locked-mode

# Copiar o código-fonte dos projetos necessários para o tooling de migrations
COPY ["backend/src/Platform.Domain/", "backend/src/Platform.Domain/"]
COPY ["backend/src/Platform.Application/", "backend/src/Platform.Application/"]
COPY ["backend/src/Platform.Infrastructure/", "backend/src/Platform.Infrastructure/"]
COPY ["backend/src/App.Api/", "backend/src/App.Api/"]

# Pré-compilar projetos para agilizar a execução de comandos EF CLI
RUN dotnet build "backend/src/Platform.Infrastructure/Platform.Infrastructure.csproj" -c Release --no-restore
RUN dotnet build "backend/src/App.Api/App.Api.csproj" -c Release --no-restore

# Definir o diretório de trabalho na pasta backend/src conforme especificação do quickstart
WORKDIR /src/backend/src
